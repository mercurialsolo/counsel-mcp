{
  "name": "counsel-mcp-server",
  "version": "0.1.2",
  "description": "Open-source MCP server for connecting AI agents to the Counsel API",
  "author": "Counsel AI",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "counsel-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js start",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "counsel",
    "ai",
    "agent",
    "llm",
    "claude",
    "openai",
    "cursor",
    "vscode",
    "strategic-reasoning",
    "debate"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mercurialsolo/counsel-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/mercurialsolo/counsel-mcp/issues"
  },
  "homepage": "https://github.com/mercurialsolo/counsel-mcp#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.7",
    "@modelcontextprotocol/sdk": "^1.0.1",
    "axios": "^1.6.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
